{
 "apps": [
  {
   "name": "n8n-db",
   "spec": {
    "source": {
     "image": {
      "ref": "postgres:18.6-trixie"
     }
    },
    "replicas": 1,
    "size": "small",
    "env": [
     {
      "name": "POSTGRES_USER",
      "value": "n8n"
     },
     {
      "name": "POSTGRES_DB",
      "value": "n8n"
     },
     {
      "name": "POSTGRES_PASSWORD",
      "valueFrom": {
       "secretKeyRef": {
        "name": "n8n",
        "key": "DB_PASSWORD"
       }
      }
     }
    ],
    "ports": [
     {
      "container": 5432
     }
    ],
    "allowFrom": [
     "n8n"
    ],
    "egress": "none",
    "volumes": [
     {
      "path": "/var/lib/postgresql",
      "size": "5Gi"
     }
    ],
    "healthCheck": {
     "port": 5432
    }
   }
  },
  {
   "name": "n8n",
   "spec": {
    "source": {
     "image": {
      "ref": "n8nio/n8n:2.41.7"
     }
    },
    "replicas": 1,
    "size": "medium",
    "env": [
     {
      "name": "DB_TYPE",
      "value": "postgresdb"
     },
     {
      "name": "DB_POSTGRESDB_HOST",
      "value": "n8n-db"
     },
     {
      "name": "DB_POSTGRESDB_PORT",
      "value": "5432"
     },
     {
      "name": "DB_POSTGRESDB_DATABASE",
      "value": "n8n"
     },
     {
      "name": "DB_POSTGRESDB_USER",
      "value": "n8n"
     },
     {
      "name": "DB_POSTGRESDB_PASSWORD",
      "valueFrom": {
       "secretKeyRef": {
        "name": "n8n",
        "key": "DB_PASSWORD"
       }
      }
     },
     {
      "name": "N8N_ENCRYPTION_KEY",
      "valueFrom": {
       "secretKeyRef": {
        "name": "n8n",
        "key": "ENCRYPTION_KEY"
       }
      }
     },
     {
      "name": "N8N_HOST",
      "value": "n8n.apps.example.com"
     },
     {
      "name": "N8N_PORT",
      "value": "5678"
     },
     {
      "name": "N8N_PROTOCOL",
      "value": "https"
     },
     {
      "name": "N8N_PROXY_HOPS",
      "value": "1"
     },
     {
      "name": "WEBHOOK_URL",
      "value": "https://n8n.apps.example.com/"
     },
     {
      "name": "N8N_EDITOR_BASE_URL",
      "value": "https://n8n.apps.example.com/"
     },
     {
      "name": "GENERIC_TIMEZONE",
      "value": "Europe/Berlin"
     },
     {
      "name": "TZ",
      "value": "Europe/Berlin"
     },
     {
      "name": "N8N_DIAGNOSTICS_ENABLED",
      "value": "false"
     }
    ],
    "ports": [
     {
      "container": 5678,
      "public": "n8n.apps.example.com"
     }
    ],
    "egress": "all"
   }
  }
 ],
 "volumes": [],
 "secretSets": [
  {
   "name": "n8n",
   "description": "n8n n8n: database password and encryption key",
   "generate": [
    "DB_PASSWORD",
    "ENCRYPTION_KEY"
   ]
  }
 ],
 "warnings": [],
 "renames": [],
 "notes": "Open https://n8n.apps.example.com and create the owner account (the first one to sign up becomes the owner, so do it now). Workflows reach any address on the internet (outbound access: unrestricted); narrow it in n8n's settings if they do not need to. Keep the key ENCRYPTION_KEY of the secret set n8n: n8n's stored credentials cannot be read without it."
}
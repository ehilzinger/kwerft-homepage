---
// A console screenshot in a browser frame, in the page's colour theme.
// Files: src/assets/screenshots/<name>-light.png and <name>-dark.png
// (made by tools/screenshots).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { name: string; alt: string; url?: string; eager?: boolean; frame?: boolean; widths?: number[]; sizes?: string; }
const { name, alt, url = "ops.example.com", eager = false, frame = true, widths = [720, 1200, 1800, 2880], sizes = "(max-width: 1200px) 100vw, 1150px" } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", { eager: true });
const pick = (theme: string) => files[`../assets/screenshots/${name}-${theme}.png`]?.default;
const light = pick("light");
const dark = pick("dark") ?? light;
const loading = eager ? "eager" : "lazy";
---
<figure class:list={["shot-fig", frame && "frame"]}>
  {frame && <div class="frame-bar" aria-hidden="true"><div class="dots"><span></span><span></span><span></span></div><div class="url">{url}</div></div>}
  {light ? (
    <>
      <Image class="only-light" src={light} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading={loading} fetchpriority={eager ? "high" : undefined} />
      {dark && <Image class="only-dark" src={dark} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading="lazy" />}
    </>
  ) : (
    <div class="shot-missing">{name}</div>
  )}
</figure>

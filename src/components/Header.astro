---
import Logo from "./Logo.astro";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/#features", label: "Features", match: "" },
  { href: "/getting-started", label: "Getting started", match: "/getting-started" },
  { href: "/docs", label: "Docs", match: "/docs" },
];
---
<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Kwerft home"><Logo />Kwerft</a>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match && path.startsWith(l.match) ? "page" : undefined}>{l.label}</a>
      ))}
      <a href="/support" aria-current={path.startsWith("/support") ? "page" : undefined}>Support</a>
    </nav>
    <div class="head-end">
      <button class="icon-btn" type="button" id="theme-btn" aria-label="Switch colour theme" title="Switch colour theme">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3.2"/><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"/></svg>
      </button>
      <a class="btn primary small" href="/getting-started">Install</a>
      <button class="icon-btn menu-btn" type="button" id="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"/></svg>
      </button>
    </div>
  </div>
</header>
<script>
  const root = document.documentElement;
  document.getElementById("theme-btn")?.addEventListener("click", () => {
    const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    const next = dark ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("kwerft-theme", next); } catch {}
  });
  const head = document.querySelector(".site-head");
  const menu = document.getElementById("menu-btn");
  menu?.addEventListener("click", () => {
    const open = !head?.hasAttribute("data-open");
    head?.toggleAttribute("data-open", open);
    menu.setAttribute("aria-expanded", String(open));
  });
  head?.querySelectorAll(".site-nav a").forEach((a) => a.addEventListener("click", () => head.removeAttribute("data-open")));
</script>

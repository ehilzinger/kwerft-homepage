---
import { render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { sortedDocs } from "../../docs";

export async function getStaticPaths() {
  const docs = await sortedDocs();
  return docs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Docs title={entry.data.title} description={entry.data.description} current={entry.id} headings={headings}>
  <Content />
</Docs>
